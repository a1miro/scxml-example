<?xml version="1.0" encoding="UTF-8"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml" initial="idle" version="1.0">
  <datamodel>
    <data id="value" expr="0"/>
  </datamodel>
  <state id="idle">
    <onentry>
      <send event="idled"/>
    </onentry>
    <transition event="start" target="active"/>
  </state>
  <state id="active">
    <onentry>
      <send event="activated"/>
    </onentry>
    <transition event="stop" target="idle"/>
    <transition event="update" target="active">
      <script>value = _event.data.value;</script>
    </transition>
  </state>
</scxml>
